# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/taskflow-ai

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret

# JWT expiry (e.g. 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Optional: enables real AI-generated task descriptions.
# Leave empty to fall back to the built-in placeholder generator.
OPENAI_API_KEY=
